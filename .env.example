# Base URL of the backend REST API, INCLUDING the /api/v1 version prefix
# (the backend mounts every REST controller under it). Expo inlines
# EXPO_PUBLIC_* variables at bundle time; this URL is public, never a secret.
#
# Deployed backend:
EXPO_PUBLIC_API_BASE_URL=https://commerce-platform-backend-k61l.onrender.com/api/v1
#
# Local development: for an Android emulator or a physical device use your
# host's reachable LAN IP instead of localhost, e.g.
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:8080/api/v1
